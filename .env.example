# Cấu hình Văn Phòng AI. File .env chứa mã bí mật: không gửi cho ai, không đưa lên mạng.
# Mã bot Telegram và nhóm làm việc được điền tự động khi bạn nối trên bảng điều khiển.
TG_TOKEN=
TG_CHAT_ID=
TG_ADMIN_ID=

# Cổng bảng điều khiển: http://localhost:8080
PORT=8080
# Chỉ máy này mở được bảng điều khiển. Đổi thành 0.0.0.0 nếu muốn mở từ điện thoại cùng Wi-Fi
# (khi đó ai cùng mạng cũng sửa được văn phòng, chỉ đổi khi bạn hiểu rủi ro).
HOST=127.0.0.1

# Bộ não chọn trên bảng điều khiển (Haiku / Sonnet / Opus). Hai dòng dưới chỉ dùng cho văn phòng cài từ bản cũ (nhẹ / mạnh).
MODEL_NHE=sonnet
MODEL_MANH=opus

# Nút Gửi lỗi, góp ý gửi về đây (để trống là toihocai.com)
GOP_Y_URL=
